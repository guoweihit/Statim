FROM ubuntu:18.04@sha256:152dc042452c496007f07ca9127571cb9c29697f42acbfad72324b2bb2e43c98

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
      build-essential pkg-config python python2.7 python3 git ca-certificates util-linux \
      libboost-dev libboost-system-dev libboost-filesystem-dev \
      libboost-date-time-dev libboost-iostreams-dev libboost-regex-dev \
      libboost-program-options-dev libboost-chrono-dev libboost-random-dev \
      libboost-thread-dev libboost-atomic-dev libboost-graph-dev libboost-log-dev \
      libboost-signals-dev libboost-test-dev libsqlite3-dev libcrypto++-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# UTF-8 filenames and text support the bilingual experiment configuration.
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

WORKDIR /code
CMD ["bash"]
